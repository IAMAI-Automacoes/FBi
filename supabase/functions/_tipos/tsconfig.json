  },
  "include": [
    "./deno.d.ts",
    "../_shared/*.ts",
    "../gerar-insights/*.ts",
    "../sugerir-acoes/*.ts",
    "../categorizar-acao/*.ts",
    "../motor-retorno-worker/*.ts",
    "../motor-retorno-callback/*.ts",
    "../vincular-feedback/*.ts"
  ]
}
