{
  "id": "/",
  "name": "Easy Feed",
  "short_name": "Easy Feed",
  "description": "Colete e entenda os feedbacks dos seus clientes, com ajuda de IA.",
  "lang": "pt-BR",
  "start_url": "/?app=easyfeed",
  "scope": "/",
  "display": "standalone",
  "related_applications": [
    { "platform": "webapp", "url": "https://easyfeed.com.br/manifest.webmanifest" },
    { "platform": "webapp", "url": "https://easyfeed.com.br/manifest-whatsapp.webmanifest" },
    { "platform": "webapp", "url": "https://easyfeed.com.br/manifest-mensagens.webmanifest" }
  ],
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
