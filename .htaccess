# Easy Feed — SPA estática na Hostinger (LiteSpeed/Apache), deploy na RAIZ (public_html).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Página pública do QR (/f/:slug): serve o bundle LEVE f.html em vez do app
  # de ~2 MB. A URL continua /f/:slug (reescrita interna). Precisa vir ANTES do
  # fallback do SPA abaixo, senão cairia no index.html.
  RewriteRule ^f/[^/]+/?$ /f.html [L]
  # React Router (BrowserRouter): tudo que NÃO é arquivo/pasta real cai no
  # index.html — faz /admin, F5 e links profundos funcionarem em vez de 404.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# MIME do manifest (alguns servidores servem como texto).
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # O service worker, o index e os manifests NÃO podem ficar em cache longo,
  # senão o PWA trava numa versão antiga. Os assets com hash (/assets/…) o
  # navegador cacheia sozinho com segurança.
  <FilesMatch "(^sw\.js$|index\.html$|f\.html$|\.webmanifest$)">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Tudo em /assets/ leva o hash do conteúdo no nome: mudou o conteúdo, mudou
  # o nome. Então nunca precisa ser revalidado — e sem esta linha o servidor
  # manda o cliente perguntar "mudou?" a cada visita, o que em rede móvel
  # custa uma ida e volta antes de qualquer byte útil.
  <FilesMatch "^.*\.(js|css|woff2|png|webp|svg)$">
    <If "%{REQUEST_URI} =~ m#^/assets/#">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </FilesMatch>
</IfModule>
