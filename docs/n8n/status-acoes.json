    {
      "parameters": {
        "jsCode": "// ===========================================================================\n// PARTE 1 — juntar os dados deste cliente\n// ===========================================================================\nconst cliente     = $('Dados Cliente').first().json\nconst restaurante = $('Dados Restaurantes').first().json\nconst alteracoes  = $('Pegar Alterações Ações').all().map(i => i.json).filter(a => a.id)\nconst pontos      = $('Pegar Feedbacks do Cliente').all().map(i => i.json).filter(f => f.id)\n\nif (alteracoes.length === 0) throw new Error('Cliente sem alteração na fila.')\n\n// Índice: id do ponto -> o ponto inteiro. É por aqui que a alteração acha o\n// texto do feedback que a originou.\nconst pontoPorId = new Map(pontos.map(p => [Number(p.id), p]))\nconst chave = (t) => (t || '').trim().toLowerCase()\nconst dia = (d) => d ? new Date(d).toLocaleDateString('pt-BR', { timeZone: 'America/Sao_Paulo' }) : null\n\nconst porAcao = new Map()\n\nfor (const alt of alteracoes) {\n  const acao = porAcao.get(alt.acao_id) ?? {\n    acao_id: alt.acao_id,\n    titulo_acao: alt.titulo_acao,\n    categoria: alt.categoria,\n    prioridade: alt.prioridade,\n    plano_detalhado: alt.plano_detalhado,\n    concluida_em: alt.concluida_em,\n    etapas: [],        // pode ter as duas: em_andamento e concluida\n    feedbacks: [],\n    vistos: new Set(), // textos já usados NESTA ação\n  }\n\n  // As duas alterações da mesma ação ficam juntas, cada etapa registrada uma vez.\n  if (!acao.etapas.includes(alt.etapa)) acao.etapas.push(alt.etapa)\n  if (alt.etapa === 'concluida') acao.concluida_em = alt.concluida_em ?? acao.concluida_em\n\n  // O feedback ligado a ESTA alteração. Se as duas alterações apontam para o\n  // mesmo ponto, o texto entra uma vez só.\n  const ponto = pontoPorId.get(Number(alt.feedback_restaurante_id))\n  if (ponto) {\n    const texto = (ponto.texto_original || ponto.resumo || '').trim()\n    if (texto && !acao.vistos.has(chave(texto))) {\n      acao.vistos.add(chave(texto))\n      acao.feedbacks.push({ texto, feedback_em: ponto.created_at })\n    }\n  }\n\n  porAcao.set(alt.acao_id, acao)\n}\n\nconst acoes = [...porAcao.values()]\n  .map(({ vistos, ...a }) => ({\n    ...a,\n    etapas: ['em_andamento', 'concluida'].filter(e => a.etapas.includes(e)),\n    etapa_final: a.etapas.includes('concluida') ? 'concluida' : 'em_andamento',\n    feedbacks: a.feedbacks.sort((x, y) => new Date(x.feedback_em) - new Date(y.feedback_em)),\n  }))\n  // Concluídas primeiro: é a boa notícia.\n  .sort((x, y) => (y.etapa_final === 'concluida') - (x.etapa_final === 'concluida') || x.acao_id - y.acao_id)\n\n// Rastro para depois do envio.\nconst pontosIds    = [...new Set(alteracoes.map(a => Number(a.feedback_restaurante_id)).filter(Boolean))]\nconst originaisIds = [...new Set(alteracoes.map(a => pontoPorId.get(Number(a.feedback_restaurante_id))?.origem_id).filter(Boolean))]\n\n// ===========================================================================\n// PARTE 2 — montar o prompt que a IA vai ler\n// ===========================================================================\nconst situacaoDe = (a) => {\n  if (a.etapas.length > 1) return 'RESOLVIDO (a equipe começou a cuidar e depois terminou; o cliente não soube de nenhuma das duas)'\n  if (a.etapa_final === 'concluida') return 'RESOLVIDO'\n  return 'EM ANDAMENTO (começaram a cuidar, ainda não terminou)'\n}\n\nconst linhas = []\nlinhas.push(`Restaurante: ${restaurante.nome_restaurante}`)\nlinhas.push('')\nlinhas.push(`ASSUNTOS (${acoes.length}). Escreva sobre todos, na ordem:`)\nlinhas.push('')\n\nacoes.forEach((a, i) => {\n  linhas.push(`${i + 1}) Situação: ${situacaoDe(a)}`)\n  linhas.push(`   O que o cliente escreveu: ${\n    a.feedbacks.length\n      ? a.feedbacks.map(f => `\"${f.texto}\"`).join(' / ')\n      : `(não temos a frase dele; o assunto é ${a.categoria || 'geral'})`\n  }`)\n  linhas.push(`   O que a equipe fez (anotação interna, NÃO copie): ${a.titulo_acao || ''}. ${(a.plano_detalhado || '').replace(/\\s*\\n+\\s*/g, ' ')}`)\n  if (a.concluida_em) linhas.push(`   Terminou em: ${dia(a.concluida_em)}`)\n  linhas.push('')\n})\n\nlinhas.push('Escreva agora a mensagem de WhatsApp para esse cliente.')\n\nconst prompt = linhas.join('\\n')\n\n// ===========================================================================\nreturn [{\n  json: {\n    // quem é e por onde mandar\n    contato_id: cliente.id,\n    telefone: cliente.telefone,\n    restaurante_id: restaurante.id,\n    nome_restaurante: restaurante.nome_restaurante,\n    whatsapp_base_url: restaurante.whatsapp_base_url,\n    whatsapp_token: restaurante.whatsapp_token,\n    // rastro para depois do envio\n    aviso_ids: alteracoes.map(a => a.id),\n    pontos_ids: pontosIds,\n    originais_ids: originaisIds,\n    pontos_pg: '{' + pontosIds.join(',') + '}',\n    originais_pg: '{' + originaisIds.join(',') + '}',\n    // dados organizados, para você conferir na tela\n    acoes,\n    // o texto pronto que vai para a IA\n    prompt,\n  },\n}]\n"
      },
