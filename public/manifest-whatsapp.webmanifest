    { "src": "/icons/whatsapp-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/whatsapp-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
